APP_NAME="R-WHILE Playground"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# このアプリはデータベースを使わない。セッションとキャッシュはファイルに置く。
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# R-WHILE 処理系（src/ を make install で置いた実行ファイル）
RWHILE_RI_BIN=
RWHILE_TIMEOUT=10
